PORT=8000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/educareer_ai_360?schema=public
JWT_SECRET=super_secret_jwt_signing_key_change_me_in_production
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TOKEN=internal_shared_auth_token_for_fastapi_ml_calls
CORS_ORIGIN=http://localhost:3000
REDIS_URL=redis://localhost:6379
AUTH_EXPOSE_DEV_TOKENS=false

# AI Career Coach provider (OpenAI-compatible chat completions).
# Leave OPENAI_API_KEY empty to disable the coach (it then reports "AI unavailable"
# instead of returning a fake answer). Do NOT commit real keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
